# Postgres connection string
DATABASE_URL=postgres://patch:patch@localhost:5432/patch

# Public URL the app is served from (used for auth callbacks and cookies)
PATCH_BASE_URL=http://localhost:3000

# Long random string used to sign sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Allow anyone to sign up. Set to "false" on a private self-hosted install after
# the first admin has registered.
PATCH_ALLOW_SIGNUP=true

# Run database migrations automatically on startup
PATCH_AUTO_MIGRATE=true

PORT=3000
